# Copy this file to .env.local and fill in your values. .env.local is gitignored.

# Enables the AI Brief and Devil's Advocate features. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Contact string SEC EDGAR's fair-access policy requires in the User-Agent header.
# Use your email or a contact URL, e.g. SEC_CONTACT=you@example.com
# On Vercel, set this in the project's Environment Variables instead.
# If left unset, SEC requests fall back to a non-personal app identifier.
SEC_CONTACT=
